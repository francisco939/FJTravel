.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 抽签主视觉 */
.lucky-hero {
  background: linear-gradient(160deg, #ff8a5c 0%, #ff5e62 60%, #e0414f 100%);
  padding: 70rpx 40rpx 90rpx;
  text-align: center;
  color: #ffffff;
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
}

.dice {
  font-size: 130rpx;
  display: inline-block;
}

.dice-shake {
  animation: shake 0.5s ease-in-out infinite;
}

@keyframes shake {
  0%   { transform: rotate(0deg) scale(1); }
  25%  { transform: rotate(-18deg) scale(1.1); }
  50%  { transform: rotate(12deg) scale(0.95); }
  75%  { transform: rotate(-8deg) scale(1.05); }
  100% { transform: rotate(0deg) scale(1); }
}

.lucky-hint {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 24rpx;
}

.draw-btn {
  display: inline-block;
  margin-top: 40rpx;
  background: #ffffff;
  color: #ff5e62;
  font-size: 30rpx;
  font-weight: 700;
  padding: 22rpx 80rpx;
  border-radius: 999rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.15);
}

.draw-disabled {
  opacity: 0.7;
}

/* 结果卡片 */
.result-title {
  font-size: 34rpx;
  font-weight: 800;
  margin: 8rpx 0 24rpx;
}

.res-card {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(43, 43, 43, 0.06);
}

.res-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-red    { background: #fff0ee; }
.avatar-gold   { background: #fdf3e3; }
.avatar-purple { background: #f3edfb; }

.res-main {
  flex: 1;
  min-width: 0;
}

.res-label {
  font-size: 22rpx;
  color: #9b9b9b;
}

.res-name {
  font-size: 32rpx;
  font-weight: 700;
  margin: 6rpx 0;
}

.res-desc {
  font-size: 24rpx;
  color: #666666;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
