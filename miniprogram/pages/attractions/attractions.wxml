<view class="page">
  <!-- 城市筛选 -->
  <scroll-view scroll-x class="chips" show-scrollbar="{{false}}">
    <view class="chip {{activeCity === '' ? 'chip-active' : ''}}"
          bindtap="onCityTap" data-city="">全部</view>
    <view class="chip {{activeCity === item.name ? 'chip-active' : ''}}"
          wx:for="{{cities}}" wx:key="id" bindtap="onCityTap" data-city="{{item.name}}">
      {{item.emoji}} {{item.name}}
    </view>
  </scroll-view>

  <!-- 列表 -->
  <view class="container">
    <view wx:if="{{loading}}" class="loading">加载中…</view>
    <view wx:elif="{{list.length === 0}}" class="empty">暂无该城市的景点</view>
    <block wx:else>
      <view class="list-item" wx:for="{{list}}" wx:key="id"
            bindtap="onItemTap" data-id="{{item.id}}">
        <view class="avatar {{item.avatar}}">
          <image wx:if="{{item.image}}" class="thumb-img" src="{{item.image}}" mode="aspectFill" />
          <text wx:else>{{item.emoji}}</text>
        </view>
        <view class="item-main">
          <view class="item-title">{{item.name}}</view>
          <view class="item-meta">📍 {{item.location}}</view>
          <view class="item-tags">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
          </view>
        </view>
        <view class="item-side">
          <view class="rate">⭐ {{item.rating}}</view>
          <view class="arrow">›</view>
        </view>
      </view>
    </block>
  </view>
</view>
